{
    "name": "live2d",
    "private": true,
    "version": "1.1.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "scan-models": "node scripts/scan-models.js",
        "watch-models": "node scripts/watch-models.js",
        "electron:dev": "concurrently --kill-others \"npm run dev\" \"npm run watch-models\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "vue-tsc -b && vite build --base=./ && electron-builder"
    },
    "main": "electron/main.cjs",
    "dependencies": {
        "@pixi/app": "^6.5.10",
        "@pixi/core": "^6.5.10",
        "@pixi/display": "^6.5.10",
        "@pixi/extensions": "^6.5.10",
        "@pixi/sprite": "^6.5.10",
        "@pixi/ticker": "^6.5.10",
        "jszip": "^3.10.1",
        "pixi-live2d-display": "^0.4.0",
        "vue": "^3.5.24"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "chokidar": "^4.0.1",
        "concurrently": "^9.2.1",
        "electron": "^42.1.0",
        "electron-builder": "^26.8.1",
        "esbuild": "^0.25.12",
        "typescript": "~5.9.3",
        "vite": "npm:rolldown-vite@7.2.5",
        "vue-tsc": "^3.1.4",
        "wait-on": "^9.0.10"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.2.5"
    },
    "build": {
        "appId": "com.live2d.desktop-pet",
        "productName": "Live2D桌宠",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "public/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/icon.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "public/icns"
        }
    }
}